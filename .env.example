# ── Chat / LLM ────────────────────────────────────────────────────────────────
# Free Groq API key → https://console.groq.com  (no credit card needed)
# When set, the Chat tab uses Groq (llama-3.3-70b by default).
GROQ_API_KEY=

# Override model or endpoint (optional — defaults shown below)
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Local LM Studio / Ollama (used when GROQ_API_KEY is not set)
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=google/gemma-4-e4b
# LLM_API_KEY=lm-studio
